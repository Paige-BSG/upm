---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { config } from "virtual:nimbus/config";
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-2xl w-full px-6 py-24">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        UPM
      </h1>
      <p class="mt-2 text-[1.0625rem] text-muted-foreground leading-relaxed">
        An open-source project to manage databases and middleware on Kubernetes — a
        thorough, open refactor of <a href="https://github.com/upmio" class="no-underline underline-offset-2 hover:underline">upmio</a>.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <a
          href="/introduction/what-is-upm"
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Introduction</div>
          <div class="mt-0.5 text-sm text-muted-foreground">What UPM is and why</div>
        </a>
        <a
          href="/architecture/overview"
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Architecture</div>
          <div class="mt-0.5 text-sm text-muted-foreground">The intended design</div>
        </a>
        <a
          href="/contributing/workflow"
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Contributing</div>
          <div class="mt-0.5 text-sm text-muted-foreground">How to get involved</div>
        </a>
      </div>

      <p class="mt-8 text-sm text-muted-foreground">
        The product source is still being refactored and is not yet in this repository.
        Read the <code>llm-wiki/</code> agent knowledge base for the pinned, license-aware
        ledger of external resources the project references.
      </p>
    </main>
  </div>
</BaseLayout>
