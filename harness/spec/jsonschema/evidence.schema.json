{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upm.dev/schema/phase1-v0.2/evidence.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "schemaVersion",
    "operationId",
    "planHash",
    "actor",
    "clusterUid",
    "sourceNamespace",
    "restoreNamespace",
    "targetPre",
    "targetPost",
    "approval",
    "journalRoot",
    "journalHead",
    "backupArtifactId",
    "backupArtifactDigest",
    "observedSchemaDigest",
    "artifactDigest",
    "artifactDestination",
    "oracle",
    "intent",
    "facts",
    "effects",
    "timeline",
    "pins",
    "trustIdentity",
    "factsSnapshotId",
    "factsDigest",
    "driftedDuring",
    "verdict",
    "pinsDigest",
    "keyId",
    "signature"
  ],
  "properties": {
    "apiVersion": { "const": "upm.dev/v0" },
    "kind": { "const": "BackupProofEvidence" },
    "schemaVersion": { "const": "phase1-v0.2" },
    "operationId": { "type": "string", "minLength": 1 },
    "planHash": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "clusterUid": { "type": "string", "minLength": 1 },
    "sourceNamespace": { "type": "string", "minLength": 1 },
    "restoreNamespace": { "type": "string", "minLength": 1 },
    "targetPre": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name", "uid", "generation", "resourceVersion", "specDigest"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "uid": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "resourceVersion": { "type": "string", "minLength": 1 },
        "specDigest": { "type": "string", "minLength": 1 }
      }
    },
    "targetPost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name", "uid", "generation", "resourceVersion", "specDigest"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "uid": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "resourceVersion": { "type": "string", "minLength": 1 },
        "specDigest": { "type": "string", "minLength": 1 }
      }
    },
    "approval": { "$ref": "approval.json" },
    "journalRoot": { "type": "string", "minLength": 1 },
    "journalHead": { "type": "string", "minLength": 1 },
    "backupArtifactId": { "type": "string", "minLength": 1 },
    "backupArtifactDigest": { "type": "string", "minLength": 1 },
    "observedSchemaDigest": { "type": "string", "minLength": 1 },
    "artifactDigest": { "type": "string", "minLength": 1 },
    "artifactDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "objectKey", "endpoint"],
      "properties": {
        "bucket": { "type": "string", "minLength": 1 },
        "objectKey": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string", "minLength": 1 }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaDigest", "count", "primaryKeyMin", "primaryKeyMax", "orderedRowHash", "setBAbsent"],
      "properties": {
        "schemaDigest": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 },
        "primaryKeyMin": { "type": "integer" },
        "primaryKeyMax": { "type": "integer" },
        "orderedRowHash": { "type": "string", "minLength": 1 },
        "setBAbsent": { "type": "boolean" }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "planHash", "factsSnapshotId", "factsDigest", "startedAtMs", "deadlineMs"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "planHash": { "type": "string", "minLength": 1 },
        "factsSnapshotId": { "type": "string", "minLength": 1 },
        "factsDigest": { "type": "string", "minLength": 1 },
        "startedAtMs": { "type": "number" },
        "deadlineMs": { "type": "number" }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "digest", "clusterUid", "targetNamespaceUid", "restoreNamespaceUid", "target"],
      "properties": {
        "snapshotId": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "clusterUid": { "type": "string", "minLength": 1 },
        "targetNamespaceUid": { "type": "string", "minLength": 1 },
        "restoreNamespaceUid": { "type": "string", "minLength": 1 },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "name", "uid", "generation", "resourceVersion", "specDigest"],
          "properties": {
            "namespace": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "uid": { "type": "string", "minLength": 1 },
            "generation": { "type": "integer", "minimum": 1 },
            "resourceVersion": { "type": "string", "minLength": 1 },
            "specDigest": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backup", "restoreCluster", "restore"],
      "properties": {
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "namespace", "name", "uid", "generation"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "uid": { "type": "string", "minLength": 1 },
            "generation": { "type": "integer", "minimum": 1 }
          }
        },
        "restoreCluster": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "namespace", "name", "uid", "generation"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "uid": { "type": "string", "minLength": 1 },
            "generation": { "type": "integer", "minimum": 1 }
          }
        },
        "restore": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "namespace", "name", "uid", "generation"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "uid": { "type": "string", "minLength": 1 },
            "generation": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAtMs", "deadlineMs", "closedAtMs"],
      "properties": {
        "startedAtMs": { "type": "number" },
        "deadlineMs": { "type": "number" },
        "closedAtMs": { "type": "number" }
      }
    },
    "pins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "admission", "candidate", "digest"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "admission": { "type": "string", "minLength": 1 },
          "candidate": { "type": "string" },
          "digest": { "type": "string" }
        }
      }
    },
    "trustIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalKeyId", "executionKeyId", "approvalPolicyVersion", "approvalSubject", "approvalRole"],
      "properties": {
        "approvalKeyId": { "type": "string", "minLength": 1 },
        "executionKeyId": { "type": "string", "minLength": 1 },
        "approvalPolicyVersion": { "type": "string", "minLength": 1 },
        "approvalSubject": { "type": "string", "minLength": 1 },
        "approvalRole": { "type": "string", "minLength": 1 }
      }
    },
    "factsSnapshotId": { "type": "string", "minLength": 1 },
    "factsDigest": { "type": "string", "minLength": 1 },
    "driftedDuring": { "type": "boolean" },
    "verdict": { "type": "string", "minLength": 1 },
    "pinsDigest": { "type": "string", "minLength": 1 },
    "keyId": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 1 }
  }
}
